# Reference only: add these values individually in Vercel Project Settings.
# Never replace this example with real secrets or upload your local .env.
APP_NAME=ZeroRiskInitiative
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-PROJECT.vercel.app
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Paste the complete service-account JSON as one private environment value.
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=YOUR-FIREBASE-PROJECT-ID
FIREBASE_DATABASE_URL=https://YOUR-DATABASE-INSTANCE.REGION.firebasedatabase.app
FIRESTORE_DATABASE_ID=(default)
FIREBASE_SESSION_MAX_AGE=43200

SESSION_DRIVER=cookie
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
SESSION_COOKIE=zerorisk_session
SESSION_DOMAIN=null

CACHE_STORE=redis
REDIS_CLIENT=phpredis
# Use the provider's Redis/TCP URL (TLS), not its HTTP REST API URL.
REDIS_URL=rediss://default:YOUR-PASSWORD@YOUR-REDIS-HOST:6379/0
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=zerorisk-production-
CACHE_PREFIX=zerorisk-production-cache-
QUEUE_CONNECTION=sync
TRUSTED_PROXIES=*
